! SPDX-License-Identifier: CC0-1.0
! Original V3 interpreter-pagination and safe-checkpoint fixture.
Release 1;
Serial "261120";
Global location;
Global score;
Global turns;
Object Room "The Reading Room";
Array input -> 160;
Array parse -> 100;
[ Main i;
  location=Room;input->0=120;parse->0=12;
  print "PAGINATION READY^";
  while(true){
    print "^>";@sread input parse;
    if(input->1=='q')quit;
    if(input->1=='b'){
      for(i=1:i<=30:i++)print "LONG LINE ",i,": Read each line before continuing.^";
      print "LONG OUTPUT COMPLETE^";
    }
  }
];
